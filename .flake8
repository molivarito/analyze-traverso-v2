[flake8]
# Flake8 configuration for Traverso Analyzer

# Maximum line length
max-line-length = 100

# Ignore specific errors/warnings
# E203: whitespace before ':' (conflicts with black)
# W503: line break before binary operator (conflicts with black)
# E501: line too long (handled by black)
ignore = E203,W503

# Exclude directories
exclude =
    .git,
    __pycache__,
    .pytest_cache,
    .mypy_cache,
    .venv,
    venv,
    env,
    build,
    dist,
    *.egg-info,
    backup_before_*,
    backup_*

# Per-file ignores
per-file-ignores =
    __init__.py:F401
    # F401: imported but unused

# Maximum complexity (for mccabe)
max-complexity = 15

# Show source code for errors
show-source = true

# Show error codes in output
show-pep8 = true

# Count errors
count = true

# Statistics
statistics = true
